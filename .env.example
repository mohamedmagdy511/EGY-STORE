# MongoDB Connection String
MONGODB_URI=mongodb://localhost:27017/egy-store
# أو لـ MongoDB Atlas:
# MONGODB_URI=mongodb+srv://username:password@cluster.mongodb.net/egy-store

# JWT Secret
JWT_SECRET=your-super-secret-jwt-key-here

# Server Port (اختياري، الافتراضي 3000)
PORT=3000

# Environment
NODE_ENV=development